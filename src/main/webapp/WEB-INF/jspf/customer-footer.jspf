<footer class="footer">
    <div class="shell">
        <div class="footer-grid">
            <div class="footer-col footer-brand-col">
                <a class="brand" href="<%= request.getContextPath() %>/index.jsp">CARVERSE</a>
                <p class="footer-tagline">Drive your next decision with confidence.</p>
                <div class="footer-copy">© 2026 CarVerse. All rights reserved.</div>
            </div>
            <div class="footer-col">
                <h4>Explore</h4>
                <ul class="footer-links">
                    <li><a href="<%= request.getContextPath() %>/index.jsp">Home</a></li>
                    <li><a href="<%= request.getContextPath() %>/car-search.jsp">Search Cars</a></li>
                    <li><a href="<%= request.getContextPath() %>/compare.jsp">Compare Cars</a></li>
                    <li><a href="<%= request.getContextPath() %>/Book_maintenance.jsp">Maintenance</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>For Businesses</h4>
                <ul class="footer-links">
                    <li><a href="<%= request.getContextPath() %>/business-register.jsp">Register Your Business</a></li>
                    <li><a href="<%= request.getContextPath() %>/business-login.jsp">Business Login</a></li>
                </ul>
